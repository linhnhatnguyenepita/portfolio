# ============================================================
# Portfolio — variables de déploiement
#
#   cp .env.example .env   puis remplissez les valeurs vides.
#
# .env est gitignoré : ne le committez jamais.
# Certaines valeurs peuvent être générées automatiquement :
#   make gen-secrets   (mot de passe Grafana + paire de clés SSH)
# ============================================================

# --- Dépôt GitHub cible pour `make secrets` (owner/repo) ---
GH_REPO=linhnhatnguyenepita/portfolio

# --- Sanity (build de l'application) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# --- VPS / SSH ---
VPS_HOST=
VPS_USER=deploy
VPS_PORT=22
# Utilisateur de connexion pour le provisioning initial (sudo).
# OVH = ubuntu ; autres fournisseurs : root.
VPS_BOOTSTRAP_USER=ubuntu
# Chemin LOCAL vers la clé privée de déploiement.
# `make gen-secrets` la crée ici si elle n'existe pas.
VPS_SSH_KEY_FILE=~/.ssh/vps_deploy_key
# Clé publique correspondante (autorise l'utilisateur deploy lors du provision).
# Remplie automatiquement par `make gen-secrets`.
SSH_PUBKEY=

# --- GitHub Container Registry (pull de l'image sur le VPS) ---
GHCR_USER=
GHCR_PAT=

# --- SonarCloud ---
SONAR_TOKEN=

# --- Grafana (monitoring, déployé par la CI) ---
# Secret GitHub poussé par `make secrets`. `make gen-secrets` le génère si vide.
GRAFANA_ADMIN_PASSWORD=
